# Copy to .env and fill in. .env is git-ignored.

# The spreadsheet ID: the long part of the sheet URL between /d/ and /edit
SHEET_ID=
# The tab your capture extension writes to (the one chosen as "Job sheet" in Settings)
JOB_SHEET_NAME=Sheet1
# Service account key downloaded from Google Cloud (see README)
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# Only needed for company careers pages that don't use a known job board.
# Any OpenAI-compatible API works; these defaults use OpenRouter.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-chat
